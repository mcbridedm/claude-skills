#!/bin/sh
# Runs one job: jobs/<name>/guard (cheap; exit 0 = work to do, 1 = nothing to do), then Claude Code
# headless with the job's prompt and only the tools in jobs/<name>/tools. A reply line starting
# "OWNER:" raises a desktop notification. Scheduled by launchd (macOS) or a systemd timer (Linux).
#
# Job folder: prompt.md (required), tools (required, one per line), guard (optional, executable),
# model (default sonnet), budget (USD cap per run, default 2), workdir (default $HOME).
set -u
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"
JOBS=$(cd "$(dirname "$0")/.." && pwd)
name=$1; dir="$JOBS/$name"
case $(uname) in Darwin) logs="$HOME/Library/Logs/claude-jobs" ;; *) logs="${XDG_STATE_HOME:-$HOME/.local/state}/claude-jobs" ;; esac
log="$logs/$name.log"; mkdir -p "$logs"
state="${CLAUDE_JOBS_STATE:-$HOME/.claude/jobs-state}"; mkdir -p "$state"
stamp() { date '+%Y-%m-%d %H:%M:%S'; }
notify() {
  msg=$(printf '%s' "$2" | tr '"' "'")
  if command -v osascript >/dev/null 2>&1; then osascript -e "display notification \"$msg\" with title \"claude job: $1\"" >/dev/null 2>&1
  elif command -v notify-send >/dev/null 2>&1; then notify-send "claude job: $1" "$msg"
  fi
}
if [ -f "$state/paused" ] || [ -f "$state/paused-$name" ]; then echo "$(stamp) $name: paused" >>"$log"; exit 0; fi
if [ -x "$dir/guard" ] && ! "$dir/guard" "$state" >>"$log" 2>&1; then
  echo "$(stamp) $name: nothing new, Claude not started" >>"$log"; exit 0
fi
tools=$(grep -v '^#' "$dir/tools" | tr '\n' ' ')
cd "${JOB_WORKDIR:-$(cat "$dir/workdir" 2>/dev/null || echo "$HOME")}" || exit 1
echo "$(stamp) $name: starting Claude" >>"$log"
# $tools is split on purpose: one --allowedTools value per line of the tools file.
# shellcheck disable=SC2086
out=$(claude -p "$(cat "$dir/prompt.md")" --allowedTools $tools --permission-mode dontAsk \
  --model "$(cat "$dir/model" 2>/dev/null || echo sonnet)" --max-budget-usd "$(cat "$dir/budget" 2>/dev/null || echo 2)" 2>&1)
printf '%s\n%s\n' "$out" "$(stamp) $name: done" >>"$log"
owner=$(printf '%s\n' "$out" | grep '^OWNER:' | head -3 | cut -c8-200)
[ -n "$owner" ] && notify "$name" "$owner"
exit 0
