<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>claude-job.example-job</string>
  <key>ProgramArguments</key><array><string>JOBS_DIR/bin/run</string><string>example-job</string></array>
  <!-- Every hour at :17. Several times a day: an <array> of <dict>s with Hour and Minute. -->
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>17</integer></dict>
  <key>StandardOutPath</key><string>HOME_DIR/Library/Logs/claude-jobs/launchd-example-job.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/Library/Logs/claude-jobs/launchd-example-job.log</string>
</dict>
</plist>
