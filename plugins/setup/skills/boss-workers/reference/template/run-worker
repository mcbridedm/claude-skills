#!/bin/bash
# Start one headless worker session for the boss, in one folder, logging to <folder>/.claude-runs/.
# Refuses if a worker started there still runs: two sessions in one working tree collide.
#
#   run-worker [--model <alias>] [--account <name>] <folder> <run name> "<brief>"
#   run-worker [--model <alias>] [--account <name>] <folder> <run name> -f <brief file>
#
# <folder> is relative to @WORKER_ROOT@, and is never the project root itself (the boss works there). Without --model, the
# account's default model; without --account, the first account. Run it in the background;
# it prints the log's tail when the worker ends.
set -u
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)" || exit 1
profile="$root/.claude/boss-workers.md"
# name=config folder, one per account; empty means the default (~/.claude).
accounts="@ACCOUNTS@"

model=""; account=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model) model="$2"; shift 2 ;;
    --account) account="$2"; shift 2 ;;
    *) break ;;
  esac
done
[ $# -ge 3 ] || { sed -n '2,10p' "$0"; exit 2; }
[ -n "$account" ] || account="${accounts%%=*}"
config=""; found=""
for pair in $accounts; do
  if [ "${pair%%=*}" = "$account" ]; then found=1; config="${pair#*=}"; fi
done
[ -n "$found" ] || { echo "unknown account: $account (have: $accounts)"; exit 2; }
config="${config/#\~/$HOME}"
if [ -n "$config" ] && [ ! -d "$config" ]; then echo "account $account isn't set up: $config is missing"; exit 2; fi

folder="$1"; name="$2"; shift 2
if [ "$1" = "-f" ]; then brief="$(cat "$2")"; else brief="$1"; fi
dir="$root/@WORKER_ROOT@/$folder"
[ -d "$dir" ] || { echo "no folder: $dir"; exit 2; }
dir="$(cd "$dir" && pwd)"
[ "$dir" != "$root" ] || { echo "not in the project root: the boss works there; use a sub-folder or a worktree"; exit 2; }
mkdir -p "$dir/.claude-runs"
lock="$dir/.claude-runs/.running"
if [ -f "$lock" ] && kill -0 "$(cat "$lock")" 2>/dev/null; then echo "a worker is still running in $dir (pid $(cat "$lock")); not starting $name"; exit 1; fi

# The project's own rules: the profile's "## Worker rules" section, up to the next heading.
project_rules="$(awk '/^## Worker rules/{on=1; next} /^## /{on=0} on' "$profile" 2>/dev/null)"

rules="RULES FOR THIS RUN: you are a headless worker for the boss session (see @RULES_DOC@). Your session ends the moment you end a turn, so never end a turn while any agent, background command or review you started is still running; wait for each one, and run sub-agents in the foreground. Never ask the person anything: where a skill says ask the user, decide from the project's own rules and decision records, record the decision there, and carry on. A question you cannot settle goes to the boss: write it in your handoff under \"Questions for the boss\" and commit it; the boss reads your handoff when you end. If ListAgents shows the boss (the session at $root), also send it one message with SendMessage naming the folder ($folder), this run ($name) and the question; if it is not listed or the send fails, do not retry or wait. Either way set that part aside and carry on with the rest of the brief; an answer may arrive as a message while you work. Stop early only when everything left depends on the answer. Send no other messages. If your shell commands all fail, or a tool you need is refused, say so plainly in your handoff and your closing summary: do not report work you could not do. A skill the Skill tool refuses is read from its SKILL.md and followed by hand when the brief says so. Commit in small green steps, and at least every 30 minutes: a usage limit can stop you without warning. Never print credentials. Never turn on usage credits or any paid extra. Before stopping, update your handoff, commit it, then end with a short plain summary.
$project_rules"

# Started from inside a sandboxed shell (macOS), a worker can't start a sandbox of its own: every
# shell command of its would fail. Only then, it runs with its own sandbox off, held by the outer one.
settings='{"crossSessionInbound":"accept"}'
if command -v sandbox-exec >/dev/null 2>&1 && ! sandbox-exec -p '(version 1)(allow default)' /usr/bin/true 2>/dev/null; then
  settings='{"crossSessionInbound":"accept","sandbox":{"enabled":false}}'
  echo "== $name: started inside a sandbox; the worker's own sandbox is off, the outer one confines it"
fi
args=(--permission-mode bypassPermissions --settings "$settings")
[ -n "$model" ] && args+=(--model "$model")
# Unset matters: a boss on a non-default account would otherwise hand its own folder to a worker
# meant for the default account, which then runs on the boss's account without saying so.
if [ -n "$config" ]; then export CLAUDE_CONFIG_DIR="$config"; else unset CLAUDE_CONFIG_DIR; fi

log="$dir/.claude-runs/$name-$(date +%Y%m%d-%H%M).log"
cd "$dir" || exit 1
claude -p "$brief

$rules" "${args[@]}" > "$log" 2>&1 &
pid=$!
echo $pid > "$lock"
wait $pid
rc=$?
rm -f "$lock"
echo "== $name (account $account${model:+, $model}) exit $rc log $log"
tail -c 4000 "$log"
exit $rc
