#!/bin/bash
# Start one headless worker session for the boss, in one folder, logging to <folder>/.claude-runs/.
# Refuses if a worker started there still runs: two sessions in one working tree collide.
#
#   run-worker [--model <alias>] [--account <name>] [--no-sign-in-check] [--outside-sandbox] <folder> <run name> "<brief>"
#   run-worker [--model <alias>] [--account <name>] [--no-sign-in-check] [--outside-sandbox] <folder> <run name> -f <brief file>
#
# <folder> is relative to @WORKER_ROOT@, and is never the project root itself (the boss works there). Without --model, the
# account's default model. Without --account, the boss's account (BOSS_WORKERS_ACCOUNT, set by the boss launcher);
# --account is for a deliberate exception, and says so. Run it in the background; it prints the log's tail when the worker ends.
set -u
# A worker outlives the terminal it was started from. Without this, closing the boss's terminal window
# (or tmux pane) sends SIGHUP to everything started from it and the worker dies mid-run (tested
# a process started this way survives the session ending normally, dies when its terminal is
# killed, and survives with HUP ignored). The ignore is inherited by the worker.
trap '' HUP
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)" || exit 1
profile="$root/.claude/boss-workers.md"

# --- Accounts (the same block in boss and run-worker) ---
# The machine file names each account once, for every project on this machine, outside any repository:
#   <name> <address> <config folder, or "default" for ~/.claude>     (# starts a comment)
# This project's accounts, by name; empty means every account in the machine file.
# The old form, name=folder pairs, still works; its address, if any, comes from the machine file.
machine="${BOSS_WORKERS_ACCOUNTS:-$HOME/.config/boss-workers/accounts}"
project_accounts="@ACCOUNTS@"
names=(); addrs=(); dirs=()
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
folder() { local d="${1/#\~/$HOME}"; [ "$d" = default ] && d=""; [ "$d" = / ] || d="${d%/}"; printf '%s' "$d"; }
shown() { printf '%s' "${1:-$HOME/.claude}"; }
state() { if [ -n "$1" ]; then printf "signed in to %s" "$1"; else printf "not signed in"; fi; }
machine_entries() { [ -f "$machine" ] && awk '{ sub(/#.*/, "") } NF == 3 { print $1, $2, $3 }' "$machine"; }
load_accounts() {
  local bad dup list entry name found addr dir old
  if [ -f "$machine" ]; then
    bad="$(awk '{ sub(/#.*/, "") } NF && NF != 3 { print "  line " NR ": " $0 }' "$machine")"
    [ -z "$bad" ] || { echo "$machine: each line needs three fields, <name> <address> <folder>:"; echo "$bad"; exit 2; }
    dup="$(machine_entries | awk '{ print $1 }' | sort | uniq -d)"
    [ -z "$dup" ] || { echo "$machine names an account twice: $dup"; exit 2; }
  fi
  list="$project_accounts"
  [ -n "$list" ] || list="$(machine_entries | awk '{ print $1 }')"
  for entry in $list; do
    name="${entry%%=*}"
    found="$(machine_entries | awk -v n="$name" '$1 == n { print $2, $3 }')"
    addr="${found%% *}"; dir="$(folder "${found#* }")"
    if [ "$entry" != "$name" ]; then
      old="$(folder "${entry#*=}")"
      if [ -n "$found" ] && [ "$old" != "$dir" ]; then
        echo "account $name: the launcher says folder $(shown "$old"), $machine says $(shown "$dir"). Make them agree."; exit 2
      fi
      dir="$old"
    elif [ -z "$found" ]; then
      echo "account $name isn't in $machine. Add a line: $name <address> <folder>"; exit 2
    fi
    names+=("$name"); addrs+=("$addr"); dirs+=("$dir")
  done
  [ ${#names[@]} -gt 0 ] || { echo "no accounts. Make $machine, one line per account: <name> <address> <folder>"; exit 2; }
}
show_accounts() {
  local i
  for i in "${!names[@]}"; do
    echo "  ${names[$i]}, ${addrs[$i]:-(no address: add it to $machine)}"
  done
}
index_of() {
  local i
  for i in "${!names[@]}"; do [ "${names[$i]}" = "$1" ] && { echo "$i"; return 0; }; done
  return 1
}
signed_in_as() {
  # The address a folder is signed in to, or nothing. Reads the status only, never a credential.
  local out
  if [ -n "$1" ]; then out="$(CLAUDE_CONFIG_DIR="$1" claude auth status --json 2>/dev/null)"
  else out="$(unset CLAUDE_CONFIG_DIR; claude auth status --json 2>/dev/null)"; fi
  printf '%s\n' "$out" | grep -q '"loggedIn": *true' || return 0
  printf '%s\n' "$out" | sed -n 's/.*"email": *"\([^"]*\)".*/\1/p' | head -1
}
two_logins() {
  # macOS: a folder can hold a Keychain item and a credentials file at once. Names only, never secrets.
  command -v security >/dev/null 2>&1 || return 0
  local d svc="Claude Code-credentials"
  d="$(shown "$1")"
  [ -n "$1" ] && svc="$svc-$(printf '%s' "$1" | shasum -a 256 | cut -c1-8)"
  if [ -f "$d/.credentials.json" ] && security find-generic-password -s "$svc" >/dev/null 2>&1; then
    echo "!! account $2: $d holds two stored logins, the Keychain item \"$svc\" and the file .credentials.json. Which one is used isn't documented. Cure: end every session in that folder, then sign out and in again there, at the machine itself (not over SSH)." >&2
  fi
}
check_signin() {
  # Refuses to start unless account $1's folder is signed in to the account's address.
  local i="$1" got j other
  local name="${names[$i]}" addr="${addrs[$i]}" dir="${dirs[$i]}"
  if [ -n "$skip_check" ]; then
    echo "!! SIGN-IN CHECK SKIPPED (--no-sign-in-check): nothing proves $(shown "$dir") is signed in to $name${addr:+, $addr}. This session may spend another account's week." >&2
    return 0
  fi
  if [ -z "$addr" ]; then
    echo "!! account $name has no address in $machine, so its sign-in isn't checked. Add a line: $name <address> ${dir:-default}" >&2
    return 0
  fi
  got="$(signed_in_as "$dir")"
  if [ "$(lower "$got")" != "$(lower "$addr")" ]; then
    echo "refusing to start: account $name is $addr, but its folder $(shown "$dir") is $(state "$got")."
    for j in "${!names[@]}"; do
      [ "$j" = "$i" ] && continue
      other="$(signed_in_as "${dirs[$j]}")"
      echo "  account ${names[$j]} (${addrs[$j]:-no address}): its folder $(shown "${dirs[$j]}") is $(state "$other")"
    done
    echo "Sign in there yourself, at the machine: end every session using $(shown "$dir"), run ${dir:+CLAUDE_CONFIG_DIR=$dir }claude, then /login as $addr. If the address in $machine is wrong, correct it there."
    exit 3
  fi
  two_logins "$dir" "$name"
}
# --- end of the accounts block ---

model=""; account=""; skip_check=""; outside=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model) [ $# -ge 2 ] || { sed -n '2,10p' "$0"; exit 2; }; model="$2"; shift 2 ;;
    --account) [ $# -ge 2 ] || { sed -n '2,10p' "$0"; exit 2; }; account="$2"; shift 2 ;;
    --no-sign-in-check) skip_check=1; shift ;;
    --outside-sandbox) outside=1; shift ;;
    *) break ;;
  esac
done
[ $# -ge 3 ] || { sed -n '2,10p' "$0"; exit 2; }
load_accounts
boss_account="${BOSS_WORKERS_ACCOUNT:-}"
if [ -z "$account" ]; then
  [ -n "$boss_account" ] || { echo "No account: the boss launcher sets BOSS_WORKERS_ACCOUNT, and it isn't set here. Give --account <name>, one of:"; show_accounts; exit 2; }
  account="$boss_account"
fi
i="$(index_of "$account")" || { echo "unknown account: $account. Known accounts:"; show_accounts; exit 2; }
address="${addrs[$i]}"; config="${dirs[$i]}"
if [ -n "$config" ] && [ ! -d "$config" ]; then echo "account $account isn't set up: $config is missing"; exit 2; fi
if [ -n "$boss_account" ] && [ "$account" != "$boss_account" ]; then
  j="$(index_of "$boss_account")"
  echo "!! exception: this worker spends the week of $account${address:+, $address}, not the boss's account $boss_account${j:+${addrs[$j]:+, ${addrs[$j]}}}, and can't message the boss." >&2
fi
check_signin "$i"

folder="$1"; name="$2"; shift 2
if [ "$1" = "-f" ]; then brief="$(cat "$2")"; else brief="$1"; fi
dir="$root/@WORKER_ROOT@/$folder"
[ -d "$dir" ] || { echo "no folder: $dir"; exit 2; }
dir="$(cd "$dir" && pwd)"
[ "$dir" != "$root" ] || { echo "not in the project root: the boss works there; use a sub-folder or a worktree"; exit 2; }
mkdir -p "$dir/.claude-runs"
lock="$dir/.claude-runs/.running"
if [ -f "$lock" ] && kill -0 "$(cat "$lock")" 2>/dev/null; then echo "a worker is still running in $dir (pid $(cat "$lock")); not starting $name"; exit 1; fi

# Is this launcher inside a sandbox? (macOS: a sandbox can't be started inside another.)
inside=""
if command -v sandbox-exec >/dev/null 2>&1 && ! sandbox-exec -p '(version 1)(allow default)' /usr/bin/true 2>/dev/null; then inside=1; fi
# Where the profile says the boss is sandboxed, a worker started from outside a sandbox has only its
# shell commands sandboxed: its file tools are held by permission rules alone (the operating rules,
# "Under a sandbox: where a worker's protection comes from"). Refuse, unless the person says so.
sandboxed="$(awk -F': *' '/^sandboxed:/{print $2; exit}' "$profile" 2>/dev/null)"
if [ "$sandboxed" = "true" ] && [ -z "$inside" ]; then
  if [ -z "$outside" ]; then
    echo "not starting $name: the profile says the boss is sandboxed, and this launcher is running outside a sandbox."
    echo "A worker started here would have only its shell commands sandboxed, not its file tools."
    echo "Start it from the boss, or, from your own terminal, pass --outside-sandbox and --account <name>."
    exit 5
  fi
  echo "!! --outside-sandbox: $name starts outside the boss's sandbox. Missing: the operating system's wall around its file tools (Read, Write, Edit); its shell commands keep its own sandbox." >&2
fi
# The self-test: can a worker write its git data here? The folder where its index and HEAD live.
gitdir="$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null)"
if [ -n "$gitdir" ]; then
  probe="$gitdir/boss-workers-probe.$$"
  if ! ( : > "$probe" ) 2>/dev/null; then
    echo "not starting $name: a worker in $dir can't write its git data ($gitdir): no add, commit or branch there."
    if [ -n "$inside" ]; then echo "Under a sandbox, workers of the boss's own repository work in standing clones, never worktrees of it (the operating rules, \"Under a sandbox\")."; fi
    exit 4
  fi
  rm -f "$probe"
  # A standing clone goes stale: say how far it is behind the root, so the brief's first fetch isn't forgotten.
  if [ "$gitdir" != "$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null)" ]; then
    roothead="$(git -C "$root" rev-parse HEAD 2>/dev/null)"
    if behind="$(git -C "$dir" rev-list --count "HEAD..$roothead" 2>/dev/null)"; then
      [ "$behind" = 0 ] || echo "== $name: $dir is $behind commit(s) behind the root's HEAD"
    else
      echo "== $name: $dir doesn't have the root's HEAD yet; the worker's first fetch brings it"
    fi
  fi
fi

# The project's own rules: the profile's "## Worker rules" section, up to the next heading.
project_rules="$(awk '/^## Worker rules/{on=1; next} /^## /{on=0} on' "$profile" 2>/dev/null)"

rules="RULES FOR THIS RUN: you are a headless worker for the boss session (see @RULES_DOC@). Your session ends the moment you end a turn, so never end a turn while any agent, background command or review you started is still running; wait for each one, and run sub-agents in the foreground. Never ask the person anything: where a skill says ask the user, decide from the project's own rules and decision records, record the decision there, and carry on. A question you cannot settle goes to the boss: write it in your handoff under \"Questions for the boss\" and save it where the boss reads it (commit it, unless the project's rules below say the handoff stays uncommitted); the boss reads your handoff when you end. If ListAgents shows the boss (the session at $root), also send it one message with SendMessage naming the folder ($folder), this run ($name) and the question; if it is not listed or the send fails, do not retry or wait. Either way set that part aside and carry on with the rest of the brief; an answer may arrive as a message while you work. Stop early only when everything left depends on the answer. Send no other messages. If your shell commands all fail, or a tool you need is refused, say so plainly in your handoff and your closing summary: do not report work you could not do. A skill the Skill tool refuses is read from its SKILL.md and followed by hand when the brief says so. Commit in small green steps, before any test run or build that may take more than 10 minutes, and at least every 30 minutes: a usage limit can stop you without warning. Hold a lock on anything other runs wait for (a test device, a deploy slot) only for the stretch that uses it, and release it in between. Never print credentials. Never turn on usage credits or any paid extra. Before stopping, update your handoff (and commit it, unless the project's rules below say it stays uncommitted), then end with a short plain summary.
$project_rules"

# Started from inside a sandboxed shell (macOS), a worker can't start a sandbox of its own: every
# shell command of its would fail. Only then, it runs with its own sandbox off, held by the outer one.
settings='{"crossSessionInbound":"accept"}'
if [ -n "$inside" ]; then
  settings='{"crossSessionInbound":"accept","sandbox":{"enabled":false}}'
  echo "== $name: started inside a sandbox; the worker's own sandbox is off, the outer one confines it"
fi
args=(--permission-mode bypassPermissions --settings "$settings")
[ -n "$model" ] && args+=(--model "$model")
# Unset matters: a boss on a non-default account would otherwise hand its own folder to a worker
# meant for the default account, which then runs on the boss's account without saying so.
if [ -n "$config" ]; then export CLAUDE_CONFIG_DIR="$config"; else unset CLAUDE_CONFIG_DIR; fi

log="$dir/.claude-runs/$name-$(date +%Y%m%d-%H%M).log"
cd "$dir" || exit 1
claude -p "$brief

$rules" "${args[@]}" > "$log" 2>&1 &
pid=$!
echo $pid > "$lock"
wait $pid
rc=$?
rm -f "$lock"
echo "== $name (account $account${address:+, $address}${model:+, $model}) exit $rc log $log"
tail -c 4000 "$log"
exit $rc
