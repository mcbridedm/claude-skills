#!/bin/bash
# Start the boss: the one interactive session the person talks to, at the project root.
# It opens by reading its rules and its state, and picks up from there.
#
#   boss                    asks which account, where there are several (no default: a bare
#                           start would otherwise land on whichever account is listed first)
#   boss --account <name>   on that account
#
# Moving the boss to another account: tell it to update its state and end, then start it again
# with the other --account. Its state is in files, so nothing is lost.
set -u
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)" || exit 1
accounts="@ACCOUNTS@"
account=""
[ "${1:-}" = "--account" ] && { account="${2:-}"; shift 2; }
if [ -z "$account" ]; then
  case "$accounts" in
    *" "*)
      # Asking needs a terminal; without one, show the usage and stop.
      [ -t 0 ] || { sed -n '2,10p' "$0"; echo "accounts: $accounts"; exit 2; }
      echo "Which account does the boss run on?"
      for pair in $accounts; do
        dir="${pair#*=}"; echo "  ${pair%%=*}  ${dir:-the default config folder}"
      done
      read -r -p "Account: " account
      ;;
    *) account="${accounts%%=*}" ;;
  esac
fi
config=""; found=""
for pair in $accounts; do
  if [ "${pair%%=*}" = "$account" ]; then found=1; config="${pair#*=}"; fi
done
[ -n "$found" ] || { echo "unknown account: $account (have: $accounts)"; exit 2; }
config="${config/#\~/$HOME}"
if [ -n "$config" ]; then
  [ -d "$config" ] || { echo "account $account isn't set up: $config is missing"; exit 2; }
  export CLAUDE_CONFIG_DIR="$config"
else
  unset CLAUDE_CONFIG_DIR
fi
cd "$root" || exit 1

# The general rules are read from the installed skill, never from a copy in the project.
cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
rules="$(for f in "$cfg"/plugins/cache/*/setup/*/skills/boss-workers/reference/operating-rules.md "$cfg"/skills/boss-workers/reference/operating-rules.md; do [ -f "$f" ] && printf '%s\n' "$f"; done | sort -V | tail -1)"
[ -n "$rules" ] || { echo "the boss-workers skill isn't installed for account $account: its operating rules are missing"; exit 2; }

claude --model @BOSS_MODEL@ "You are the boss, running on account $account. Read $rules (the general operating rules, in the installed skill; its version is in the path or the plugin.json above it), then .claude/boss-workers.md and @RULES_DOC@ (this project's own), then @STATE_FILE@. If the rules' version differs from the one in your state, follow the rules' section on keeping the rules the same across projects. If @STATE_FILE@ doesn't exist yet, this is the first start: build it from the project's handoffs and state files, in the shape of the rules doc's \"The boss's state\" section, then commit it. Then read each account's limits with claude -p \"/usage\" (a non-default account with CLAUDE_CONFIG_DIR set), list the sessions still running with ListAgents, and tell me in a few lines what's running, what's next and what you need from me."
